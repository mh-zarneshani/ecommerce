# Legacy diagnostics/test settings below.
AGENT_MODE=offline
# For an explicitly authorized, class-demo-only live model session:
# AGENT_MODE=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
